---
// Estilos
import "../styles/global.css";
// Fuentes
import "@fontsource/outfit";
// Paraglide i18n
import * as m from "@/paraglide/messages";
import Footer from "../components/Footer.astro";
import LanguagePicker from "../components/LanguagePicker.astro";
// Componentes
import ThemeToggle from "../components/ThemeToggle.astro";
// Config
import { ASSETS_BASE } from "../config/assets";

// Props del layout
interface Props {
	title: string;
	lang?: "es" | "en";
}

const { title, lang = "es" } = Astro.props;
const opt = { locale: lang };
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={m.meta_description({}, opt)} />

		<!-- Favicon -->
		<link rel="icon" type="image/png" href={`${ASSETS_BASE}/favicon.png`} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={m.meta_description({}, opt)} />
		<meta property="og:image" content={`${ASSETS_BASE}/og-main.png`} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={m.meta_description({}, opt)} />
		<meta property="twitter:image" content={`${ASSETS_BASE}/og-main.png`} />

		<title>{title}</title>

		<!-- Script de persistencia de tema (evita flash al cargar) -->
		<script is:inline>
			(function() {
				try {
					// 1. Lee la preferencia guardada en localStorage
					var saved = JSON.parse(localStorage.getItem("preferences") || "{}");
					// 2. Si no hay preferencia, usa la del sistema
					var theme = (saved && saved.state && saved.state.theme) ||
						(window.matchMedia("(prefers-color-scheme: dark)").matches ? "business" : "nord");
					// 3. Aplica el tema al <html>
					document.documentElement.setAttribute("data-theme", theme);
					if (theme === 'business') document.documentElement.classList.add('dark');
				} catch(e) {}
			})();
		</script>

		<!-- Datos estructurados JSON-LD para SEO -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Ivan Cruz",
			"url": "https://web-portfolio.mgdc.site",
			"jobTitle": "Desarrollador Web Frontend & Cloud Hosting",
			"sameAs": [
				"https://github.com/Ivandv19",
				"https://linkedin.com/in/ivancruzdev"
			],
			"knowsAbout": [
				"Frontend Development",
				"React",
				"Astro",
				"Cloud Hosting",
				"Infrastructure"
			],
			"hasOfferCatalog": {
				"@type": "OfferCatalog",
				"name": m.services_title({}, opt),
				"itemListElement": [
					{
						"@type": "Offer",
						"itemOffered": {
							"@type": "Service",
							"name": m.services_landing_title({}, opt),
							"description": m.services_landing_desc({}, opt)
						}
					},
					{
						"@type": "Offer",
						"itemOffered": {
							"@type": "Service",
							"name": m.services_infra_title({}, opt),
							"description": m.services_infra_desc({}, opt)
						}
					}
				]
			}
		})}>
		</script>
	</head>
	<body class="flex flex-col min-h-screen bg-base-100 text-base-content antialiased transition-colors duration-400">

		{/* Navbar */}
		<header class="navbar bg-base-100/80 text-base-content backdrop-blur-md border-b border-base-content/10 sticky top-0 z-50 px-4 lg:px-8 xl:px-20">
			<div class="navbar-start">
				<a href="#hero" class="text-xl font-bold tracking-tighter">
					{m.nav_logo_text({}, opt)}<span class="text-primary">{m.nav_logo_highlight({}, opt)}</span>
				</a>
			</div>

			<div class="navbar-center hidden xl:flex">
				<ul class="menu menu-horizontal px-1 font-medium gap-2 flex-nowrap">
					<li><a href="#hero" class="hover:text-primary transition-colors">{m.nav_home({}, opt)}</a></li>
					<li><a href="#servicios" class="hover:text-primary transition-colors">{m.nav_services({}, opt)}</a></li>
					<li><a href="#proyectos" class="hover:text-primary transition-colors">{m.nav_projects({}, opt)}</a></li>
					<li><a href="#testimonios" class="hover:text-primary transition-colors">{m.nav_testimonials({}, opt)}</a></li>
					<li><a href="#sobre-mi" class="hover:text-primary transition-colors">{m.nav_about({}, opt)}</a></li>
				</ul>
			</div>

			<div class="navbar-end">
				<div class="hidden xl:flex items-center gap-2">
					<a href="#contacto" class="btn btn-primary btn-sm text-white border-none px-6">
						{m.nav_contact({}, opt)}
					</a>
					<ThemeToggle class="ml-2" />
					<LanguagePicker />
				</div>

				{/* Menú móvil */}
				<div class="dropdown dropdown-end xl:hidden">
					<label tabindex="0" class="btn btn-ghost">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
						</svg>
					</label>
					<ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-1 p-2 shadow bg-base-200 rounded-box w-52 font-medium">
						<li><a href="#hero">{m.nav_home({}, opt)}</a></li>
						<li><a href="#servicios">{m.nav_services({}, opt)}</a></li>
						<li><a href="#proyectos">{m.nav_projects({}, opt)}</a></li>
						<li><a href="#testimonios">{m.nav_testimonials({}, opt)}</a></li>
						<li><a href="#sobre-mi">{m.nav_about({}, opt)}</a></li>
						<div class="divider my-1 opacity-5"></div>
						<li class="p-2">
							<div class="flex items-center justify-between w-full">
								<span class="text-[10px] font-bold opacity-40 uppercase tracking-widest">{lang === 'es' ? 'Idioma' : 'Language'}</span>
								<LanguagePicker />
							</div>
						</li>
						<li class="p-2 flex flex-row gap-2 items-center">
							<a href="#contacto" class="btn btn-primary btn-sm text-white grow h-10 min-h-0">{m.nav_contact({}, opt)}</a>
							<ThemeToggle class="bg-base-300/50" />
						</li>
					</ul>
				</div>
			</div>
		</header>

		{/* Contenido principal con espacio para footer pegajoso */}
		<main class="grow">
			<slot />
		</main>

		<Footer lang={lang} />

		{/* Observer de animaciones al hacer scroll (reveal on scroll) */}
		<script>
			function initAnimateOnScroll() {
				const observerOptions = {
					root: null,
					rootMargin: '0px',
					threshold: 0.1
				};

				const observer = new IntersectionObserver((entries, obs) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							obs.unobserve(entry.target);
						}
					});
				}, observerOptions);

				const hiddenElements = document.querySelectorAll('.animate-on-scroll');
				hiddenElements.forEach((el) => observer.observe(el));
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initAnimateOnScroll);
			} else {
				initAnimateOnScroll();
			}
		</script>
	</body>
</html>
