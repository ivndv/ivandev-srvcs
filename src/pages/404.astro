---
// Paraglide i18n
import * as m from "@/paraglide/messages";
// Layout
import Layout from "../layouts/Layout.astro";
---

{/* Página 404 — no encontrada */}
<Layout title="404 - Página no encontrada">
  <div class="hero min-h-[80vh] flex items-center justify-center text-center px-4">
    <div class="max-w-md">
      {/* Icono animado */}
      <div class="mb-8 flex justify-center">
        <div class="relative">
          <div class="absolute -inset-4 bg-primary/20 rounded-full blur-xl animate-pulse"></div>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="100"
            height="100"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary relative z-10"
          >
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </div>
      </div>

      <h1 class="text-7xl font-black mb-4">404</h1>

      <h2 class="text-2xl font-bold mb-4">{m.page_404_title()}</h2>

      <p class="py-6 text-lg opacity-70">
        {m.page_404_desc()}
      </p>

      <a href="/" class="btn btn-primary text-white btn-wide">
        {m.page_404_button()}
      </a>
    </div>
  </div>
</Layout>
