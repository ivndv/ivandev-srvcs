---
// Paraglide i18n
import * as m from "@/paraglide/messages";

const currentLang = (Astro.currentLocale || "es") as "es" | "en";
const opt = { locale: currentLang };

const githubAvatar = "https://avatars.githubusercontent.com/u/157653669";
---

{/* Sección Hero — presentación principal */}
<section id="hero" class="hero min-h-[90vh] bg-base-200">
  <div class="hero-content flex-col lg:flex-row-reverse gap-12 px-4 lg:px-20">
    {/* Avatar con glow animado */}
    <div class="relative group animate-on-scroll">
      <div
        class="absolute -inset-1 bg-gradient-to-r from-primary to-secondary rounded-full blur opacity-25 group-hover:opacity-50 transition duration-1000"
      >
      </div>
      <div class="avatar">
        <div
          class="w-48 md:w-64 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2"
        >
          <img
            src={githubAvatar}
            alt="Ivan Cruz"
            width="400"
            height="400"
            loading="eager"
            decoding="async"
            class="rounded-full shadow-lg object-cover"
          />
        </div>
      </div>
    </div>

    <div class="text-center lg:text-left max-w-2xl animate-on-scroll text-base-content">
      <h1 class="text-5xl md:text-6xl font-black mb-4 leading-tight">
        {m.hero_greeting({}, opt)} <span class="text-primary">Ivan Cruz</span> {m.hero_role({}, opt)}
      </h1>

      <p class="py-6 text-lg opacity-90 leading-relaxed text-base-content">
        <span set:html={m.hero_description({}, opt)} />
      </p>

      <div class="flex flex-wrap gap-4 justify-center lg:justify-start mb-8">
        <a href="#proyectos" class="btn btn-primary">{m.hero_cta({}, opt)}</a>
      </div>

      {/* Redes sociales */}
      <div
        class="flex flex-wrap items-center justify-center gap-6 md:gap-8 mb-12 text-sm md:text-base"
      >
        <a
          href="https://github.com/Ivandv19"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 hover:text-primary transition-colors py-1"
        >
          <span class="iconify w-5 h-5 i-lucide-github" aria-hidden="true"></span>
          <span>GitHub</span>
        </a>
        <a
          href="https://linkedin.com/in/ivancruzdev"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 hover:text-primary transition-colors py-1"
        >
          <span class="iconify w-5 h-5 i-lucide-linkedin" aria-hidden="true"></span>
          <span>LinkedIn</span>
        </a>
        <a
          href="mailto:ivangtx19@gmail.com"
          class="flex items-center gap-2 hover:text-primary transition-colors py-1"
        >
          <span class="iconify w-5 h-5 i-lucide-mail" aria-hidden="true"></span>
          <span>ivangtx19@gmail.com</span>
        </a>
      </div>
    </div>
  </div>
</section>
