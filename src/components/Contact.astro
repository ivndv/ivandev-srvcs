---
// Paraglide i18n
import * as m from "@/paraglide/messages";

const currentLang = (Astro.currentLocale || "es") as "es" | "en";
const opt = { locale: currentLang };
---

{/* Sección Contacto — formulario e información de contacto */}
<section id="contacto" class="py-24 px-4 lg:px-20 bg-base-100">
  <div class="max-w-6xl mx-auto animate-on-scroll">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      {/* Información de contacto */}
      <div class="lg:sticky lg:top-32">
        <h2 class="text-5xl font-black mb-6 text-base-content">
          <span set:html={m.contact_title({}, opt)} />
        </h2>
        <p class="text-lg text-base-content/70 mb-8">
          {m.contact_desc({}, opt)}
        </p>

        <div class="lg:col-span-1 space-y-4">
          {/* Tarjeta de correo electrónico */}
          <div class="relative group">
            <a
              href="mailto:ivangtx19@gmail.com"
              class="card bg-base-200 border border-white/5 shadow-xl p-6 flex-row items-center gap-4 hover:border-primary/30 transition-all active:scale-95"
            >
              <div class="bg-primary/10 text-primary p-3 rounded-xl">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
                    d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
                >
              </div>
              <div class="flex-1">
                <h4
                  class="font-bold text-sm uppercase tracking-widest text-base-content/60"
                >
                  {m.contact_email({}, opt)}
                </h4>
                <p class="text-sm font-semibold text-base-content">ivangtx19@gmail.com</p>
              </div>
            </a>
            <button
              onclick="navigator.clipboard.writeText('ivangtx19@gmail.com')"
              class="btn btn-ghost btn-xs absolute right-4 top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 transition-opacity"
              title="Copiar correo">{m.contact_copy({}, opt)}</button
            >
          </div>

          {/* Tarjeta de WhatsApp */}
          <div class="relative group">
            <a
              href="https://wa.me/525667723938"
              target="_blank"
              class="card bg-base-200 border border-white/5 shadow-xl p-6 flex-row items-center gap-4 hover:border-secondary/30 transition-all active:scale-95"
            >
              <div class="bg-secondary/10 text-secondary p-3 rounded-xl">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                  ></path></svg
                >
              </div>
              <div class="flex-1">
                <h4
                  class="font-bold text-sm uppercase tracking-widest text-base-content/60"
                >
                  {m.contact_whatsapp({}, opt)}
                </h4>
                <p class="text-sm font-semibold text-base-content">+52 56 6772 3938</p>
              </div>
            </a>
            <button
              onclick="navigator.clipboard.writeText('525667723938')"
              class="btn btn-ghost btn-xs absolute right-4 top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 transition-opacity"
              title="Copiar número">{m.contact_copy({}, opt)}</button
            >
          </div>

          {/* Tarjeta de ubicación */}
          <div class="relative group">
            <a
              href="https://www.google.com/maps/place/México/@23.634501,-102.552784,5z/"
              target="_blank"
              class="card bg-base-200 border border-white/5 shadow-xl p-6 flex-row items-center gap-4 hover:border-accent/30 transition-all active:scale-95"
            >
              <div class="bg-accent/10 text-accent p-3 rounded-xl">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                  ></path><circle cx="12" cy="10" r="3"></circle></svg
                >
              </div>
              <div class="flex-1">
                <h4
                  class="font-bold text-sm uppercase tracking-widest text-base-content/60"
                >
                  {m.contact_location({}, opt)}
                </h4>
                <p class="text-sm font-semibold text-base-content">México</p>
              </div>
            </a>
          </div>
        </div>
      </div>

      {/* Formulario de contacto */}
      <div class="card bg-base-200 shadow-xl border border-white/5">
        <form 
          id="contactForm" 
          class="card-body p-8 flex flex-col gap-y-5"
          data-msg-sending={m.contact_form_sending({}, opt)}
          data-msg-success={m.contact_form_success({}, opt)}
          data-msg-error={m.contact_form_error({}, opt)}
        >
          
          {/* Honeypot invisible anti-bots */}
          <input
            type="text"
            name="fax_number"
            style="display:none !important"
            tabindex="-1"
            autocomplete="off"
          />

          <div class="form-control w-full">
            <label for="nombre" class="label pb-1">
              <span class="label-text font-semibold">{m.contact_form_name({}, opt)}</span>
            </label>
            <input
              id="nombre"
              name="nombre"
              type="text"
              placeholder="Ej. Ivan Cruz"
              class="input input-bordered w-full focus:input-primary transition-all"
              required
            />
          </div>

          <div class="form-control w-full">
            <label for="email" class="label pb-1">
              <span class="label-text font-semibold">{m.contact_form_email({}, opt)}</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="tu@email.com"
              class="input input-bordered w-full focus:input-primary transition-all"
              required
            />
          </div>

          <div class="form-control w-full">
            <label for="servicio" class="label pb-1">
              <span class="label-text font-semibold"
                >{m.contact_form_service({}, opt)}</span
              >
            </label>
            <select
              id="servicio"
              name="servicio"
              class="select select-bordered w-full focus:select-primary transition-all"
            >
              <option disabled selected>{m.contact_form_service_option_default({}, opt)}</option>
              <option>{m.contact_form_service_option_frontend({}, opt)}</option>
              <option>{m.contact_form_service_option_hosting({}, opt)}</option>
              <option>{m.contact_form_service_option_pack({}, opt)}</option>
            </select>
          </div>

          <div class="form-control w-full">
            <label for="mensaje" class="label pb-1">
              <span class="label-text font-semibold">{m.contact_form_message({}, opt)}</span>
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              class="textarea textarea-bordered h-32 w-full focus:textarea-primary transition-all"
              placeholder={m.contact_form_message_placeholder({}, opt)}
              required></textarea>
          </div>

          {/* Widget de Cloudflare Turnstile */}
          <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
          <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}></div>

          <div id="formStatus" class="hidden alert text-sm mt-2"></div>

          <div class="form-control mt-4">
            <button
              type="submit"
              id="submitBtn"
              class="btn btn-primary btn-block text-white"
            >
              {m.contact_form_submit({}, opt)}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // 1. Selecciona elementos del DOM
  const form = document.getElementById('contactForm');
  const statusDiv = document.getElementById('formStatus');
  const submitBtn = document.getElementById('submitBtn');

  // 2. Obtiene mensajes traducidos desde los atributos data
  const msgSending = form.dataset.msgSending;
  const msgSuccess = form.dataset.msgSuccess;
  const msgError = form.dataset.msgError;

  // 3. Escucha el evento submit del formulario
  form.addEventListener('submit', async function (e) {
    e.preventDefault();

    // 3a. UI: Cambia botón a estado de carga
    const originalBtnText = submitBtn.innerText;
    submitBtn.innerText = msgSending;
    submitBtn.disabled = true;
    statusDiv.classList.add('hidden');

    // 3b. Captura datos del formulario
    const formData = new FormData(form);
    const data = Object.fromEntries(formData);
    
    // 3c. Valida token de Turnstile
    const turnstileToken = formData.get('cf-turnstile-response');
    if (!turnstileToken) {
       submitBtn.innerText = originalBtnText;
       submitBtn.disabled = false;
       statusDiv.innerText = "Por favor completa la verificación de seguridad (captcha).";
       statusDiv.className = 'alert alert-warning mt-2 shadow-lg';
       statusDiv.classList.remove('hidden');
       return;
    }

    try {
      // 4. Envía los datos al backend
      const response = await fetch('/api/send-email', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (response.ok) {
        // 4a. Éxito — muestra mensaje y limpia el formulario
        statusDiv.innerText = msgSuccess;
        statusDiv.className = 'alert alert-success mt-2 text-white shadow-lg';
        statusDiv.classList.remove('hidden');
        form.reset();
      } else {
        // 4b. Error del servidor
        statusDiv.innerText = result.error || msgError;
        statusDiv.className = 'alert alert-error mt-2 text-white shadow-lg';
        statusDiv.classList.remove('hidden');
      }
    } catch (error) {
      console.error('[CONTACTO] Error de red:', error);
      statusDiv.innerText = msgError;
      statusDiv.className = 'alert alert-error mt-2 text-white shadow-lg';
      statusDiv.classList.remove('hidden');
    } finally {
      // 5. Restaura el botón
      submitBtn.innerText = originalBtnText;
      submitBtn.disabled = false;

      // 5a. Oculta mensaje de éxito después de 5 segundos
      if (statusDiv.classList.contains('alert-success')) {
        setTimeout(() => {
          statusDiv.classList.add('hidden');
        }, 5000);
      }
    }
  });
</script>
