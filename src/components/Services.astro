---
// Paraglide i18n
import * as m from "@/paraglide/messages";

const currentLang = (Astro.currentLocale || "es") as "es" | "en";
const opt = { locale: currentLang };
---

{/* Sección Servicios — soluciones web y cloud */}
<section id="servicios" class="py-24 px-4 lg:px-20 bg-base-100">
  <div class="max-w-4xl mx-auto text-center mb-16 animate-on-scroll">
    <h2
      class="text-4xl font-black mb-4 uppercase tracking-tight text-base-content"
    >
      {m.services_title({}, opt)}
    </h2>
    <p class="text-lg text-base-content/80">
      {m.services_subtitle({}, opt)}
    </p>
  </div>

  {/* Tarjetas de servicios principales */}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl mx-auto">
    <div
      class="card bg-base-200 shadow-xl border-t-4 border-primary hover:scale-[1.02] transition-transform duration-300 animate-on-scroll"
    >
      <div class="card-body">
        <div class="text-4xl mb-2">⚡</div>
        <h3 class="card-title text-2xl font-bold text-base-content">
          {m.services_landing_title({}, opt)}
        </h3>
        <p class="text-sm text-base-content/80 min-h-[60px]">
          {m.services_landing_desc({}, opt)}
        </p>
      </div>
    </div>

    <div
      class="card bg-base-200 shadow-xl border-t-4 border-secondary hover:scale-[1.02] transition-transform duration-300 animate-on-scroll"
    >
      <div class="card-body">
        <div class="text-4xl mb-2">🎨</div>
        <h3 class="card-title text-2xl font-bold">
          {m.services_portfolio_title({}, opt)}
        </h3>
        <p class="text-sm opacity-80 min-h-[60px]">
          {m.services_portfolio_desc({}, opt)}
        </p>
      </div>
    </div>

    <div
      class="card bg-base-200 shadow-xl border-t-4 border-accent hover:scale-[1.02] transition-transform duration-300 animate-on-scroll"
    >
      <div class="card-body">
        <div class="text-4xl mb-2">✍️</div>
        <h3 class="card-title text-2xl font-bold">
          {m.services_blog_title({}, opt)}
        </h3>
        <p class="text-sm opacity-80 min-h-[60px]">
          {m.services_blog_desc({}, opt)}
        </p>
      </div>
    </div>
  </div>

  {/* Badges del stack */}
  <div
    class="mt-12 flex flex-wrap justify-center items-center gap-12 opacity-30 font-black text-2xl uppercase tracking-widest"
  >
    <span>Astro</span>
    <span>Tailwind</span>
    <span>React</span>
    <span>TypeScript</span>
  </div>

  {/* Sección de infraestructura */}
  <div class="mt-32">
    <div class="max-w-4xl mx-auto text-center mb-16">
      <h2 class="text-3xl font-black mb-4 uppercase tracking-tight">
        {m.services_infra_title({}, opt)}
      </h2>
      <p class="text-lg opacity-70">
        {m.services_infra_desc({}, opt)}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
      {/* Tarjeta DevOps */}
      <div
        class="card bg-neutral text-neutral-content shadow-2xl border border-white/5 group animate-on-scroll"
      >
        <div class="card-body">
          <div class="flex items-start justify-between mb-4">
            <h3 class="card-title text-2xl font-bold text-secondary">
              {m.services_devops_title({}, opt)}
            </h3>
            <div class="text-3xl group-hover:rotate-12 transition-transform">
              🛠️
            </div>
          </div>

          <p class="text-sm opacity-80 mt-4 mb-6 min-h-[80px]">
            {m.services_devops_desc({}, opt)}
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-y-4 gap-x-6">
            <div class="flex items-center gap-3 text-sm">
              <span class="text-secondary font-bold text-lg">✦</span>
              <span>{m.services_devops_features_cicd({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-secondary font-bold text-lg">✦</span>
              <span>{m.services_devops_features_iac({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-secondary font-bold text-lg">✦</span>
              <span>{m.services_devops_features_monitor({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-secondary font-bold text-lg">✦</span>
              <span>{m.services_devops_features_sec({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-secondary font-bold text-lg">✦</span>
              <span>{m.services_devops_features_opt({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-secondary font-bold text-lg">✦</span>
              <span>{m.services_devops_features_agile({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-secondary font-bold text-lg">✦</span>
              <span>{m.services_devops_features_docker({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-secondary font-bold text-lg">✦</span>
              <span>{m.services_devops_features_pipe({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-secondary font-bold text-lg">✦</span>
              <span>{m.services_devops_features_micro({}, opt)}</span>
            </div>
          </div>
        </div>
      </div>

      {/* Tarjeta Cloud */}
      <div
        class="card bg-neutral text-neutral-content shadow-2xl border border-white/5 group animate-on-scroll"
      >
        <div class="card-body">
          <div class="flex items-start justify-between mb-4">
            <h3 class="card-title text-2xl font-bold text-primary">
              {m.services_cloud_title({}, opt)}
            </h3>
            <div class="text-3xl group-hover:scale-110 transition-transform">
              ☁️
            </div>
          </div>
          <p class="text-sm opacity-80 mt-4 mb-6 min-h-[80px]">
            {m.services_cloud_desc({}, opt)}
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-y-4 gap-x-6">
            <div class="flex items-center gap-3 text-sm">
              <span class="text-primary font-bold text-lg">✦</span>
              <span>{m.services_cloud_features_domain({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-primary font-bold text-lg">✦</span>
              <span>{m.services_cloud_features_email({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-primary font-bold text-lg">✦</span>
              <span>{m.services_cloud_features_ssl({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-primary font-bold text-lg">✦</span>
              <span>{m.services_cloud_features_av({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-primary font-bold text-lg">✦</span>
              <span>{m.services_cloud_features_sec({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-primary font-bold text-lg">✦</span>
              <span>{m.services_cloud_features_cdn({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-primary font-bold text-lg">✦</span>
              <span>{m.services_cloud_features_edge({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-primary font-bold text-lg">✦</span>
              <span>{m.services_cloud_features_back({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-primary font-bold text-lg">✦</span>
              <span>{m.services_cloud_features_maint({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-primary font-bold text-lg">✦</span>
              <span>{m.services_cloud_features_mig({}, opt)}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-primary font-bold text-lg">✦</span>
              <span>{m.services_cloud_features_self({}, opt)}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Plataformas cloud soportadas */}
    <div
      class="mt-12 flex flex-wrap justify-center items-center gap-12 opacity-30 font-black text-2xl uppercase tracking-widest"
    >
      <span>Azure</span>
      <span>OCI</span>
      <span>Vercel</span>
      <span>Netlify</span>
      <span>Cloudflare</span>
    </div>
  </div>
</section>
